  <style id="preloader-guard">#preloader{display:none !important}#preloader:before,#preloader:after{display:none !important}</style>
<style id="fat-nav-guard">.fat-nav.active{display:block !important}</style>
</head>
  <body class={bodyClass}>
    <slot />
    <script is:inline>
      // Staging site: newsletter and comment forms have no endpoint, so
      // submissions are stopped here and a note is shown instead.
      document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".mc4wp-form, .comment-form").forEach(function (form) {
          form.addEventListener("submit", function (e) {
            e.preventDefault();
            if (!form.nextElementSibling || !form.nextElementSibling.classList.contains("staging-form-note")) {
              var note = document.createElement("p");
              note.className = "staging-form-note";
              note.textContent = "Thanks. This form is front end only on this staging site, so nothing was sent.";
              form.insertAdjacentElement("afterend", note);
            }
          });
        });
      });
    </script>
  <script id="fat-nav-sync">
document.addEventListener("DOMContentLoaded", function () {
  document.querySelectorAll(".mobile-wrapper .hamburger").forEach(function (btn) {
    btn.addEventListener("click", function (e) {
      e.preventDefault();
      if (e.stopImmediatePropagation) e.stopImmediatePropagation();
      var wrap = btn.closest(".mobile-wrapper");
      if (!wrap) return;
      var nav = wrap.querySelector(".fat-nav");
      if (!nav) return;
      var opening = !btn.classList.contains("active");
      btn.classList.toggle("active", opening);
      nav.classList.toggle("active", opening);
      nav.style.display = opening ? "block" : "none";
      document.body.classList.toggle("nav-active", opening);
    });
  });
});
</script>
</body>
</html>
