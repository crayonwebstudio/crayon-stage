    <link rel="stylesheet" href="/wp-content/uploads/sites/6/elementor/css/post-144.css?v=1" />
    <link rel="stylesheet" href="/wp-content/uploads/sites/6/elementor/css/post-434.css?v=1" />
    <link rel="stylesheet" href="/wp-content/uploads/sites/6/elementor/css/post-437.css?v=1" />
    <link rel="stylesheet" href="/wp-content/uploads/sites/6/elementor/css/post-440.css?v=1" />
    <link rel="stylesheet" href="/wp-content/uploads/sites/6/elementor/css/post-443.css?v=1" />
    <link rel="stylesheet" href="/wp-content/uploads/sites/6/elementor/css/post-471.css?v=1" />
    <link rel="stylesheet" href="/wp-content/uploads/sites/6/elementor/css/post-479.css?v=1" />
    <link rel="stylesheet" href="/wp-content/uploads/sites/6/elementor/css/post-822.css?v=1" />
    <link rel="stylesheet" href="/wp-content/uploads/sites/6/elementor/css/post-824.css?v=1" />
    <link rel="stylesheet" href="/wp-content/uploads/sites/6/elementor/css/post-826.css?v=1" />
    <link rel="stylesheet" href="/wp-content/uploads/sites/6/elementor/css/post-828.css?v=1" />
    <link rel="stylesheet" href="/wp-content/uploads/sites/6/elementor/css/post-830.css?v=1" />
    <link rel="stylesheet" href="/wp-content/uploads/sites/6/elementor/css/post-832.css?v=1" />
  <style id="preloader-guard">#preloader{display:none !important}#preloader:before,#preloader:after{display:none !important}</style>
<style id="fat-nav-guard">.fat-nav.active{display:block !important}</style>
<style id="offcanvas-submenu">#menu-offcanvas-menu .sub-menu{display:none}#menu-offcanvas-menu .sub-menu.sub-open{display:block;padding-left:24px}#menu-offcanvas-menu .menu-item-has-children > a{display:inline-block}#menu-offcanvas-menu .offcanvas-sub-toggle{display:inline-block;cursor:pointer;color:#fff;font-size:24px;line-height:1;margin-left:12px;vertical-align:middle}#menu-offcanvas-menu .sub-menu a{text-transform:none;color:#fff}#menu-offcanvas-menu li.sub-open-parent > a{color:#F7931E}.tcg-offcanvas-wrapper .offcanvas-container .offcanvas-close{left:auto!important;right:0!important;background:transparent!important}.progress-wrap{border-radius:0!important;background:#151515!important}.progress-wrap::after{color:#fff!important}.progress-wrap svg{display:none!important}</style>
</head>
  <body class={bodyClass}>
    <slot />
    <Footer />
    <script is:inline>
      // Staging site: newsletter and comment forms have no endpoint, so
      // submissions are stopped here and a note is shown instead.
      document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".mc4wp-form, .comment-form").forEach(function (form) {
          form.addEventListener("submit", function (e) {
            e.preventDefault();
            if (!form.nextElementSibling || !form.nextElementSibling.classList.contains("staging-form-note")) {
              var note = document.createElement("p");
              note.className = "staging-form-note";
              note.textContent = "Thanks. This form is front end only on this staging site, so nothing was sent.";
              form.insertAdjacentElement("afterend", note);
            }
          });
        });
      });
    </script>
  <script id="fat-nav-sync">
document.addEventListener("DOMContentLoaded", function () {
  document.querySelectorAll(".mobile-wrapper .hamburger").forEach(function (btn) {
    btn.addEventListener("click", function (e) {
      e.preventDefault();
      if (e.stopImmediatePropagation) e.stopImmediatePropagation();
      var wrap = btn.closest(".mobile-wrapper");
      if (!wrap) return;
      var nav = wrap.querySelector(".fat-nav");
      if (!nav) return;
      var opening = !btn.classList.contains("active");
      btn.classList.toggle("active", opening);
      nav.classList.toggle("active", opening);
      nav.style.display = opening ? "block" : "none";
      document.body.classList.toggle("nav-active", opening);
    });
  });
});
</script>
<script id="offcanvas-submenu">
document.addEventListener("DOMContentLoaded", function () {
  document.querySelectorAll("#menu-offcanvas-menu .menu-item-has-children").forEach(function (li) {
    var sub = li.querySelector(":scope > .sub-menu");
    if (!sub || li.querySelector(".offcanvas-sub-toggle")) return;
    var t = document.createElement("i");
    t.className = "offcanvas-sub-toggle";
    t.textContent = "+";
    t.setAttribute("aria-label", "Toggle submenu");
    var link = li.querySelector(":scope > a");
    if (link) link.insertAdjacentElement("afterend", t);
    else li.prepend(t);
    t.addEventListener("click", function (e) {
      e.preventDefault();
      e.stopPropagation();
      var open = sub.classList.toggle("sub-open");
      li.classList.toggle("sub-open-parent", open);
      t.textContent = open ? "-" : "+";
    });
  });
});
</script>
</body>
</html>
