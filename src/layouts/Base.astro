    <link rel="stylesheet" href="/wp-content/themes/artech/assets/css/splitting-cells.css?v=1" />
    <link rel="stylesheet" href="/wp-content/themes/artech/style.css?v=1" />
    <link rel="stylesheet" href="/wp-content/plugins/elementor/assets/css/frontend.min.css?v=1" />
    <link rel="stylesheet" href="/wp-content/uploads/sites/6/elementor/css/post-5.css?v=1" />
    <link rel="stylesheet" href="/wp-content/plugins/artech_plugin/elements/assets/css/global/laby.css?v=1" />
