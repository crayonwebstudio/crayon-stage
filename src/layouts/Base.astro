---
import Footer from "../components/Footer.astro";
interface Props {
  title: string;
  description: string;
  canonical: string;
  bodyClass?: string;
}
const { title, description, canonical, bodyClass = "" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Crayonweb Studio" />
    <link rel="icon" href="/crayon/crayon_icon.png" sizes="32x32" />
    <script type="application/ld+json">{"@context": "https://schema.org", "@graph": [{"@type": "Organization", "@id": "https://crayonwebstudio.com/#organization", "name": "Crayonweb Studio", "url": "https://crayonwebstudio.com", "logo": "https://crayonwebstudio.com/crayon/logo-main.png", "email": "info@crayonwebstudio.com", "telephone": "+91 9624052424", "address": {"@type": "PostalAddress", "streetAddress": "319, 3rd Floor, Sagar Complex, Jasonath Chowk", "addressLocality": "Bhavnagar", "postalCode": "364001", "addressCountry": "IN"}}, {"@type": "WebSite", "@id": "https://crayonwebstudio.com/#website", "url": "https://crayonwebstudio.com", "name": "Crayonweb Studio", "publisher": {"@id": "https://crayonwebstudio.com/#organization"}}]}</script>
    <script is:inline src="/wp-includes/js/jquery/jquery.min.js?v=1"></script>
    <script is:inline src="/wp-includes/js/jquery/jquery-migrate.min.js?v=1"></script>
