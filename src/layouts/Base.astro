  <style is:global id="preloader-guard">#preloader{display:none !important}#preloader:before,#preloader:after{display:none !important}</style>
<style is:global id="fat-nav-guard">.fat-nav.active{display:block !important}</style>
<style is:global id="offcanvas-submenu">.menu-offcanvas-menu-container .sub-menu,.tcg-offcanvas-wrapper .sub-menu{display:none}.menu-offcanvas-menu-container .sub-menu.sub-open,.tcg-offcanvas-wrapper .sub-menu.sub-open{display:block;padding-left:24px}.menu-offcanvas-menu-container .menu-item-has-children > a,.tcg-offcanvas-wrapper .menu-item-has-children > a{display:inline-block!important}.menu-offcanvas-menu-container .offcanvas-sub-toggle,.tcg-offcanvas-wrapper .offcanvas-sub-toggle{display:inline-block;cursor:pointer;color:#fff;font-size:24px;line-height:1;margin-left:8px;vertical-align:middle;position:static!important;width:auto!important;top:auto!important;right:auto!important;bottom:auto!important;background:transparent!important}.menu-offcanvas-menu-container .sub-menu a,.tcg-offcanvas-wrapper .sub-menu a{text-transform:none!important;color:#fff}.menu-offcanvas-menu-container .menu-item-has-children > a:before,.menu-offcanvas-menu-container .menu-item-has-children > a:after,.tcg-offcanvas-wrapper .menu-item-has-children > a:before,.tcg-offcanvas-wrapper .menu-item-has-children > a:after{display:none!important}.menu-offcanvas-menu-container .menu-item-has-children,.tcg-offcanvas-wrapper .menu-item-has-children{display:flex!important;flex-wrap:wrap!important;justify-content:flex-start!important;align-items:center!important}.menu-offcanvas-menu-container .menu-item-has-children > .sub-menu,.tcg-offcanvas-wrapper .menu-item-has-children > .sub-menu{flex-basis:100%!important}.menu-offcanvas-menu-container li.sub-open-parent > a,.tcg-offcanvas-wrapper li.sub-open-parent > a{color:#F7931E!important}.fat-nav .sub-menu.sub-open{display:block!important;padding-left:24px}.fat-nav .sub-menu a{text-transform:none!important}.fat-nav li.sub-open-parent > a{color:#F7931E!important}.fat-nav .offcanvas-sub-toggle{display:inline-block;cursor:pointer;color:#151515;font-size:20px;line-height:1;margin-left:8px;vertical-align:middle}.tcg-offcanvas-wrapper .offcanvas-container .offcanvas-close{left:auto!important;right:145px!important;top:30px!important;background:transparent!important}.progress-wrap{border-radius:0!important;background:#151515!important}.progress-wrap::after{color:#fff!important}.progress-wrap svg{display:none!important}</style>
<style is:global id="homepage-fixes">
[data-id="ef8d5ad"]{background-image:linear-gradient(rgba(0,0,0,0.045) 1px,transparent 1px),linear-gradient(90deg,rgba(0,0,0,0.045) 1px,transparent 1px)!important;background-size:44px 44px!important;}
img[src*="hero-team.png"]{filter:drop-shadow(0 30px 28px rgba(247,147,30,0.55))!important;}
.artech-capabilities-slider .capabilities-card .description{color:#888!important;}
.artech-project-slider .title-section .nav-pills{background-color:rgba(255,255,255,0.08)!important;border-color:rgba(255,255,255,0.25)!important;}
.artech-project-slider .title-section .nav-pills .nav-link{color:#ccc!important;}
.artech-project-slider .title-section .nav-pills .nav-link.active{color:#fff!important;}
.artech-project-slider .title-section .main-title{color:rgba(255,255,255,0.13)!important;}
.artech-testimonials .testi-card{height:100%!important;display:flex!important;flex-direction:column!important;}
.artech-testimonials .testi-card .user-info{margin-top:auto!important;padding-top:50px!important;}
.artech-testimonials .swiper-wrapper{align-items:stretch!important}.artech-testimonials .swiper-slide{display:flex!important;height:auto!important}.artech-testimonials .testi-card{flex:1 1 auto!important;}
.menu-offcanvas-menu-container .sub-menu a,.tcg-offcanvas-wrapper .sub-menu a{color:#fff!important;opacity:1!important;font-weight:700!important;}
[data-id="f0afd64"],[data-id="96409a8"]{overflow:visible!important;}
</style>
</head>
  <body class={bodyClass}>
    <slot />
    <Footer />
    <script is:inline>
      // Staging site: newsletter and comment forms have no endpoint, so
      // submissions are stopped here and a note is shown instead.
      document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".mc4wp-form, .comment-form").forEach(function (form) {
          form.addEventListener("submit", function (e) {
            e.preventDefault();
            if (!form.nextElementSibling || !form.nextElementSibling.classList.contains("staging-form-note")) {
              var note = document.createElement("p");
              note.className = "staging-form-note";
              note.textContent = "Thanks. This form is front end only on this staging site, so nothing was sent.";
              form.insertAdjacentElement("afterend", note);
            }
          });
        });
      });
    </script>
  <script id="fat-nav-sync">
document.addEventListener("DOMContentLoaded", function () {
  document.querySelectorAll(".mobile-wrapper .hamburger").forEach(function (btn) {
    btn.addEventListener("click", function (e) {
      e.preventDefault();
      if (e.stopImmediatePropagation) e.stopImmediatePropagation();
      var wrap = btn.closest(".mobile-wrapper");
      if (!wrap) return;
      var nav = wrap.querySelector(".fat-nav");
      if (!nav) return;
      var opening = !btn.classList.contains("active");
      btn.classList.toggle("active", opening);
      nav.classList.toggle("active", opening);
      nav.style.display = opening ? "block" : "none";
      document.body.classList.toggle("nav-active", opening);
    });
  });
});
</script>
<script id="offcanvas-submenu">
document.addEventListener("DOMContentLoaded", function () {
  document.querySelectorAll(".menu-offcanvas-menu-container .menu-item-has-children, .tcg-offcanvas-wrapper .menu-item-has-children, .fat-nav .menu-item-has-children").forEach(function (li) {
    var sub = li.querySelector(":scope > .sub-menu");
    if (!sub || li.querySelector(".offcanvas-sub-toggle")) return;
    var link = li.querySelector(":scope > a");
    if (!link) return;
    var isFat = !!li.closest(".fat-nav");
    var t = document.createElement("i");
    t.className = "offcanvas-sub-toggle";
    t.textContent = "+";
    t.setAttribute("aria-label", "Toggle submenu");
    t.style.setProperty("display", "inline-block", "important");
    t.style.setProperty("position", "static", "important");
    t.style.setProperty("width", "auto", "important");
    t.style.setProperty("top", "auto", "important");
    t.style.setProperty("right", "auto", "important");
    t.style.setProperty("bottom", "auto", "important");
    t.style.setProperty("background", "transparent", "important");
    t.style.setProperty("margin-left", "8px", "important");
    t.style.setProperty("padding", "6px 10px 6px 0", "important");
    t.style.setProperty("cursor", "pointer", "important");
    t.style.setProperty("vertical-align", "middle", "important");
    t.style.setProperty("font-style", "normal", "important");
    t.style.setProperty("font-weight", "700", "important");
    t.style.setProperty("font-size", isFat ? "20px" : "24px", "important");
    t.style.setProperty("color", isFat ? "#151515" : "#fff", "important");
    link.appendChild(t);
    t.addEventListener("click", function (e) {
      e.preventDefault();
      e.stopPropagation();
      var open = sub.classList.toggle("sub-open");
      li.classList.toggle("sub-open-parent", open);
      t.textContent = open ? "-" : "+";
      if (open) { link.style.setProperty("color", "#F7931E", "important"); }
      else { link.style.removeProperty("color"); }
    });
  });
});
</script>
</body>
</html>
