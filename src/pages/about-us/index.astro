---
import Base from "../../layouts/Base.astro";
import bodyHtml from "../../fragments/about-us.html?raw";
const title = "About Us";
const description = "Crayonweb is a creative web design and digital agency specializing in TYPO3 development, branding, and digital marketing.";
const canonical = "https://stage.woodwolfdigital.com/about-us/";
const schema = "{\"@context\": \"https://schema.org\", \"@type\": \"WebPage\", \"name\": \"About Us\", \"description\": \"Crayonweb is a creative web design and digital agency specializing in TYPO3 development, branding, and digital marketing.\", \"url\": \"https://stage.woodwolfdigital.com/about-us/\"}";
const breadcrumbs = "[{\"name\": \"Home\", \"url\": \"https://stage.woodwolfdigital.com/\"}, {\"name\": \"About Us\", \"url\": \"https://stage.woodwolfdigital.com/about-us/\"}]";
---
<Base title={title} description={description} canonical={canonical} type="website" schema={schema} breadcrumbs={JSON.parse(breadcrumbs)}>
  <div set:html={bodyHtml} />
</Base>
