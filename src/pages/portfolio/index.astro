---
import Base from "../../layouts/Base.astro";
import bodyHtml from "../../fragments/portfolio.html?raw";
const title = "Portfolio - Crayonweb Studio";
const description = "Crayonweb portfolio: TYPO3, headless, mobile, Magento, and Laravel/Vue projects.";
const canonical = "https://stage.woodwolfdigital.com/portfolio/";
const bodyClass = "page";
---
<Base title={title} description={description} canonical={canonical} bodyClass={bodyClass}>
