---
import Base from "../layouts/Base.astro";
import bodyHtml from "../fragments/index.html?raw";
const title = "Design Studio";
const description = "Artech Design Studio demo page on this staging site. Demo placeholder copy, kept as supplied.";
const canonical = "https://stage.woodwolfdigital.com/";
const bodyClass = "home page-template page-template-blank-builder page-template-blank-builder-php page page-id-7 wp-embed-responsive  elementor-default elementor-kit-5 elementor-page elementor-page-7";
---
<Base title={title} description={description} canonical={canonical} bodyClass={bodyClass}>
  <div set:html={bodyHtml} />
</Base>
