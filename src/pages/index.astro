---
import Base from "../layouts/Base.astro";
import bodyHtml from "../fragments/index.html?raw";
const title = "Crayonweb Studio - Creative Digital Studio | TYPO3 Agency | TYPO3 Headless CMS";
const description = "Crayonweb Studio, a creative digital studio and TYPO3 agency: web and app development, UI/UX design, CMS integration, e-commerce and API development.";
const canonical = "https://crayonwebstudio.com/";
const bodyClass = "home page-template page-template-blank-builder page-template-blank-builder-php page page-id-7 wp-embed-responsive  elementor-default elementor-kit-5 elementor-page elementor-page-7";
---
<Base title={title} description={description} canonical={canonical} bodyClass={bodyClass}>
  <div set:html={bodyHtml} />
</Base>
